# EMP-12 Environment Configuration
# Copy this file to .env and insert your API credentials

# Google Gemini API Key for Grounded Generation (Required for Phases 5+)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_GENERATION_TEMPERATURE=0.2
MAX_CONTEXT_RESULTS=5

# Embedding Model Identifier (Default: sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Similarity Threshold for Fallback Guardrail (Default: 0.65)
SIMILARITY_THRESHOLD=0.65

# Top-k Retrieved Documents (Default: 3)
TOP_K_RETRIEVAL=3

# Application Environment (development / production)
APP_ENV=development

# Phase 6 Guardrail & Hallucination Control Settings
RETRIEVAL_SCORE_THRESHOLD=0.55
MIN_RELEVANT_RESULTS=1
SCORE_GAP_AMBIGUITY_THRESHOLD=0.03
USE_CATEGORY_CONSISTENCY=true
USE_TERM_MATCH_SIGNAL=true
